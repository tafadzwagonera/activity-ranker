{
  "name": "@activity-ranker/fe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn --cwd ../shared build && nuxt build",
    "dev": "nuxt dev --port 3001",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "yarn --cwd ../shared build && node ./scripts/run-typecheck.mjs",
    "test:ci": "yarn --cwd ../shared build && vitest run --coverage",
    "test:e2e": "yarn --cwd ../shared build && playwright test",
    "test:fe:ui": "yarn --cwd ../shared build && vitest --ui",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@activity-ranker/shared": "0.0.1",
    "@nuxt/ui": "^4.1.0",
    "@vueuse/core": "^13.2.0",
    "@vueuse/nuxt": "^13.2.0",
    "dotenv": "^17.4.2",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "nuxt": "^4.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@nuxt/test-utils": "^3.17.2",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/vue": "^8.1.0",
    "@vitest/coverage-v8": "^3.1.4",
    "@vitest/ui": "^3.1.4",
    "@vue/compiler-dom": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "happy-dom": "^17.6.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "vue-eslint-parser": "^10.1.1",
    "vue-tsc": "^2.2.10"
  }
}
