{
  "name": "@activity-ranker/next",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn --cwd ../shared build && next build",
    "dev": "next dev --port 3002",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:ci": "yarn --cwd ../shared build && vitest run --coverage"
  },
  "dependencies": {
    "@activity-ranker/shared": "0.0.1",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
